# ── Opsional ──────────────────────────────────────────────
# Fallback key jika client tidak kirim key sendiri
# Kalau dikosongkan, client WAJIB kirim key via Authorization header
FREEMODEL_API_KEY=fe_oa_xxx

# ── Opsional: Gate Key ────────────────────────────────────
# Jika diisi, client harus kirim Authorization: Bearer <API_KEY>
# DAN FreeModel key-nya via header X-FreeModel-API-Key
# Jika dikosongkan, client bebas pakai key sendiri
API_KEY=

# ── Port (default: 8000) ─────────────────────────────────
PORT=8000
